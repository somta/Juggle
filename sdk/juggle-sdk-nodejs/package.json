{
  "name": "juggle-client",
  "version": "1.0.1",
  "description": "juggle (https://juggle.plus) nodejs sdk",
  "scripts": {
    "test": "ts-node test.ts",
    "clear": "rimraf dist types cjs esm",
    "build-types": "tsc --declaration -p . -t es2015 --emitDeclarationOnly --outDir types",
    "build": "rollup -c",
    "contributors": "contributors -f plain -o AUTHORS",
    "clean": "rimraf node_modules cjs esm types",
    "release": "npm publish"
  },
  "types": "types/index.d.ts",
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "exports": {
    ".": {
      "require": "./cjs/index.js",
      "import": "./esm/index.js"
    }
  },
  "files": [
    "cjs/",
    "esm/",
    "types/",
    "README.md"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/somta/Juggle/issues"
  },
  "homepage": "https://juggle.plus",
  "engines": {
    "node": ">= 18"
  },
  "ci": {
    "type": "travis",
    "version": "8, 10"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "28.0.1",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.1.1",
    "@types/node-fetch": "2",
    "contributors": "0.5.1",
    "lerna": "8.1.8",
    "rimraf": "6.0.1",
    "rollup": "4.24.0",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "node-fetch": "2"
  }
}
