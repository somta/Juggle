<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.matecoder.juggle.console.infrastructure.mapper.system.TokenMapper" >

    <select id="queryTokenByValue" resultType="com.matecoder.juggle.console.infrastructure.po.system.TokenPO" parameterType="java.lang.String">
        select id as id, token_value as tokenValue
        from t_token where token_value = #{tokenValue}
    </select>

</mapper>   
